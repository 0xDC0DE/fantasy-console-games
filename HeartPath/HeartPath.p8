pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
-- heart path
-- sfx 1 new level, 2 try again, 3 button
-- sfx 4 left, 5 right, 6 up, 7 down
-- sfx 8 dog, 9 bunny, 10 cat, 11 duck pickup
animal_names={"dog","bunny","cat","duck"}
animal_sprites={0,3,6,9}
-- left, right, up, down
dx={-1,1,0,0}
dy={0,0,-1,1}
arrow_colors={11,8,12,10}
heart_sprite=76
tree_sprite=128
house_sprite=132
bush_sprite=136
pond_sprite=139
rock_sprite=196
mushroom_sprite=198

function center(s,y,c)
 print(s,64-#s*2,y,c)
end

function _init()
 pal(6,140,1)
 pal(9,137,1)
 pal(11,138,1)
 srand(time())
 state="menu"
 animal=1
 difficulty=2
 level=1
 hearts=0
end

function tile_x(x) return 32+x*16 end
function tile_y(y) return 65+y*16 end

function blocked(x,y)
 return x<0 or x>3 or y<0 or y>2
end

function new_level()
 hearts=0
 px=flr(rnd(4))
 py=flr(rnd(3))
 scenery=flr(rnd(3))
 make_round()
 state="reveal"
 timer=60
end

function grow_path(x,y,visited,path)
 if #path==difficulty then return path,x,y end
 local choices={1,2,3,4}
 while #choices>0 do
  local index=1+flr(rnd(#choices))
  local dir=choices[index]
  deli(choices,index)
  local nx=x+dx[dir]
  local ny=y+dy[dir]
  local key=ny*4+nx+1
  if not blocked(nx,ny) and not visited[key] then
   visited[key]=true
   add(path,dir)
   local result,rx,ry=grow_path(nx,ny,visited,path)
   if result then return result,rx,ry end
   deli(path,#path)
   visited[key]=nil
  end
 end
 return nil
end

function try_path()
 local visited={}
 visited[py*4+px+1]=true
 return grow_path(px,py,visited,{})
end

function make_round()
 local path,x,y=try_path()
 sequence=path
 hx=x
 hy=y
 entered={}
 walk_step=1
 facing=2
end

function preview()
 entered={}
 state="preview"
 timer=180
end

function confirm()
 if #entered!=difficulty then return end
 for i=1,difficulty do
  if entered[i]!=sequence[i] then
   sfx(2)
   preview()
   return
  end
 end
 state="walk"
 walk_step=1
 timer=0
end

function _update60()
 if state=="menu" or state=="between" then
  if state=="between" and btnp(4) then
   state="menu"
   sfx(3)
   return
  end
  if btnp(0) then animal=(animal+2)%4+1 sfx(3) end
  if btnp(1) then animal=animal%4+1 sfx(3) end
  if state=="menu" then
   if btnp(2) then difficulty=min(5,difficulty+1) sfx(3) end
   if btnp(3) then difficulty=max(2,difficulty-1) sfx(3) end
  end
  if btnp(5) then
   if state=="menu" then level=1 end
   new_level()
   sfx(3)
  end
 elseif state=="reveal" then
  timer-=1
  if timer<=0 then preview() end
 elseif state=="preview" then
  timer-=1
  local elapsed=180-timer
  local gap=flr(90/(#sequence-1))
  for i=1,#sequence do
   if elapsed==20+(i-1)*gap then
    sfx(3+sequence[i])
   end
  end
  if timer<=0 then state="input" end
 elseif state=="input" then
  if btnp(4) then
   if #entered>0 then deli(entered,#entered) sfx(3)
   else state="menu" sfx(3) end
  else
   for dir=0,3 do
    if btnp(dir) and #entered<difficulty then
     local chosen=dir+1
     add(entered,chosen)
     sfx(3+chosen)
     if #entered==difficulty then
      state="check_wait"
      timer=12
     end
     break
    end
   end
  end
 elseif state=="check_wait" then
  timer-=1
  if timer<=0 then confirm() end
 elseif state=="walk" then
  timer+=1
  if timer>=18 then
   timer=0
   local dir=sequence[walk_step]
   px+=dx[dir]
   py+=dy[dir]
   facing=dir
   sfx(3+dir)
   walk_step+=1
   if walk_step>#sequence then
    state="pickup_wait"
    timer=10
   end
  end
 elseif state=="pickup_wait" then
  timer-=1
  if timer<=0 then
   hearts+=1
   sfx(7+animal)
   state="pickup"
   timer=0
  end
 elseif state=="pickup" then
  timer+=1
  if timer>=42 then
   if hearts==3 then
    state="levelup"
    timer=0
    sfx(1)
   else
    make_round()
    preview()
   end
  end
 elseif state=="levelup" then
  timer+=1
  if timer>=90 then
   level+=1
   state="between"
  end
 end
end

function draw_arrow(dir,x,y,c)
 if dir==1 then
  line(x-4,y,x+4,y,c)
  line(x-4,y,x-1,y-3,c)
  line(x-4,y,x-1,y+3,c)
 elseif dir==2 then
  line(x-4,y,x+4,y,c)
  line(x+4,y,x+1,y-3,c)
  line(x+4,y,x+1,y+3,c)
 elseif dir==3 then
  line(x,y-4,x,y+4,c)
  line(x,y-4,x-3,y-1,c)
  line(x,y-4,x+3,y-1,c)
 else
  line(x,y-4,x,y+4,c)
  line(x,y+4,x-3,y+1,c)
  line(x,y+4,x+3,y+1,c)
 end
end

function draw_animal(x,y)
 local bob=state=="walk" and flr(timer/5)%2 or 0
 local flip=animal==4 and facing==2
 spr(animal_sprites[animal],x-4,y-8-bob,3,3,flip)
end

function draw_menu()
 cls(6)
 rectfill(0,81,127,127,3)
 line(0,80,127,80,11)
 if state=="between" then
  center("level "..level,5,7)
  center("pick a friend",21,7)
 else
  center("heart path",5,7)
  center("pick a friend",21,7)
 end
 for i=1,4 do
  local x=4+(i-1)*32
  if i==animal then
   -- Small symmetric V selector with a gap above the sprite.
   pset(x+10,33,7) pset(x+14,33,7)
   pset(x+11,34,7) pset(x+13,34,7)
   pset(x+12,35,7)
  end
  spr(animal_sprites[i],x,40,3,3)
 end
 center("< "..animal_names[animal].." >",69,7)
 if state=="menu" then
  -- A tiny up arrow and V bracket the selected sequence length.
  pset(62,87,7) pset(64,87,7) pset(66,87,7)
  pset(63,86,7) pset(65,86,7) pset(64,85,7)
  center("length "..difficulty,92,10)
  pset(62,101,7) pset(66,101,7)
  pset(63,102,7) pset(65,102,7) pset(64,103,7)
 else
  for i=1,3 do
   spr(heart_sprite+1,48+(i-1)*12,95)
  end
 end
end

function draw_hud()
 print("lv "..level,5,4,7)
 for i=1,3 do
  local x=42+(i-1)*16
  spr(i<=hearts and heart_sprite or heart_sprite+1,x,4)
 end
 print(difficulty.." steps",94,4,7)
end

function draw_scenery()
 local left=scenery%2==0
 local tree_x=left and 0 or 96
 local house_x=left and 104 or 0
 rectfill(0,0,127,57,6)
 rectfill(0,58,127,114,3)
 line(0,58,127,58,11)
 -- Clouds sit well above the horizon.
 circfill(12,34,4,7) circfill(19,33,5,7)
 circfill(108,35,4,7) circfill(116,34,5,7)
 spr(tree_sprite,tree_x,46,4,6)
 spr(house_sprite,house_x,75,3,3)
 spr(pond_sprite,tree_x,99,4,2)
 if scenery==0 then
  spr(bush_sprite,house_x,99,3,2)
 elseif scenery==1 then
  spr(rock_sprite,house_x+4,99,2,2)
 else
  spr(mushroom_sprite,house_x+4,99,2,2)
 end
 for i=1,4 do
  local x=31+i*17+scenery%3
  pset(x,110,11)
  pset(x,108,i%2==0 and 14 or 10)
  pset(x-1,109,7)
  pset(x+1,109,7)
 end
end

function draw_field()
 draw_scenery()
 if state!="pickup" and state!="levelup" then
  spr(heart_sprite,tile_x(hx)+4,tile_y(hy)+4)
 end
 draw_animal(tile_x(px),tile_y(py))
 if state=="pickup" then
  spr(heart_sprite,tile_x(px)+4,tile_y(py)-flr(timer/4))
 end
 draw_hud()
end

function draw_footer()
 rectfill(0,115,127,127,3)
 if state=="reveal" then center("watch the path!",27,7)
 elseif state=="preview" then center("remember the arrows",119,7)
 elseif state=="walk" then center("here we go!",27,7)
 elseif state=="pickup" or state=="pickup_wait" then center("a heart!",27,8)
 elseif state=="levelup" then center("new level!",27,10)
 else
  local gap=16
  local start=64-(difficulty-1)*gap/2
  for i=1,difficulty do
   local x=start+(i-1)*gap
   if i<=#entered then
    draw_arrow(entered[i],x,36,arrow_colors[entered[i]])
   else line(x-5,44,x+5,44,7) end
  end
  for dir=1,4 do
   local x=28+(dir-1)*24
   draw_arrow(dir,x,121,arrow_colors[dir])
  end
 end
end

function draw_preview()
 rectfill(11,15,116,53,1)
 rect(11,15,116,53,7)
 center("remember!",20,7)
 local gap=18
 local start=64-(difficulty-1)*gap/2
 local elapsed=180-timer
 local tone_gap=flr(90/(#sequence-1))
 for i=1,difficulty do
  local x=start+(i-1)*gap
  draw_arrow(sequence[i],x,39,arrow_colors[sequence[i]])
  local cue=20+(i-1)*tone_gap
  if elapsed>=cue and elapsed<cue+10 then
   line(x-4,47,x+4,47,7)
  end
 end
end

function _draw()
 if state=="menu" or state=="between" then draw_menu() return end
 draw_field()
 draw_footer()
 if state=="preview" then draw_preview() end
end
__gfx__
