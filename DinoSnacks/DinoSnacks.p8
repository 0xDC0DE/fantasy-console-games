pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
-- dino snacks
-- original sprites and sounds
-- sfx 0: heart pickup, 1: next space, 2: back, 3: selection
-- d-pad only once a game starts

-- 7 columns x 6 rows of 16px cells.
-- 24px dinosaurs are centred on each cell.
-- each food spot is reached in order.
spaces={
 {rows={
  ".......",
  ".......",
  "..#o...",
  "..o#...",
  ".......",
  "......."},
  start={0,2},food={{6,2},{6,0},{0,5}}},
 {rows={
  "...ww..",
  "...ww..",
  ".......",
  ".......",
  "...#...",
  "...o..."},
  start={0,2},food={{6,2},{6,0},{0,5}}},
 {rows={
  ".......",
  "..#o#..",
  ".......",
  ".......",
  "..wwo..",
  "......."},
  start={0,2},food={{6,2},{6,5},{0,5}}},
 {rows={
  "..o....",
  "..#....",
  ".......",
  ".......",
  "....ww.",
  "....ww."},
  start={0,0},food={{6,0},{6,5},{0,5}}},
 {rows={
  ".......",
  ".o#.ww.",
  ".......",
  ".......",
  ".wwo#..",
  "......."},
  start={0,0},food={{6,0},{6,5},{0,5}}}
}

names={"stegosaur","t-rex","triceratops"}
-- sprite numbers are 24x24 frames (3x3 8px tiles).
-- frames: right idle/walk, front idle/walk,
-- back idle/walk. left mirrors right.
dino_sprites={{0,3,6,9,12,48},
 {51,54,57,60,96,99},
 {102,105,108,144,147,150}}
leaf_sprite=192
steak_sprite=194
leaf_outline=196
steak_outline=198
rock_sprite=200
rock_alt_sprite=202
pool_sprite=204
heart_sprite=206

function center(s,y,c)
 print(s,64-#s*2,y,c)
end

function _init()
 -- a softer shared palette for the imported sprites and ground.
 pal(2,141,1)
 pal(4,139,1)
 pal(9,142,1)
 pal(14,143,1)
 state="menu"
 selected=1
 space_num=1
 facing=1
 held_dir=-1
 hold_frames=0
 steps=0
end

function start_space()
 local space=spaces[space_num]
 px=space.start[1]
 py=space.start[2]
 food_num=1
 collected=0
 held_dir=-1
 hold_frames=0
 facing=1
 steps=0
 state="play"
end

function blocked(x,y)
 if x<0 or x>6 or y<0 or y>5 then
  return true
 end
 return sub(spaces[space_num].rows[y+1],x+1,x+1)!="."
end

function try_move(dir)
 local dx=0
 local dy=0
 if dir==0 then dx=-1
 elseif dir==1 then dx=1
 elseif dir==2 then dy=-1
 else dy=1 end
 facing=dir
 if not blocked(px+dx,py+dy) then
  px+=dx
  py+=dy
  steps+=1
  local food=spaces[space_num].food[food_num]
  if px==food[1] and py==food[2] then
   collected+=1
   sfx(0)
   state="eat"
   eat_frames=0
   held_dir=-1
   hold_frames=0
  end
 end
end

function update_movement()
 local dir=-1
 for i=0,3 do
  if btn(i) then
   dir=i
   break
  end
 end
 if dir==-1 then
  held_dir=-1
  hold_frames=0
 elseif dir!=held_dir then
  held_dir=dir
  hold_frames=0
  try_move(dir)
 else
  hold_frames+=1
  if hold_frames>=14 and (hold_frames-14)%9==0 then
   try_move(dir)
  end
 end
end

function _update60()
 if state=="menu" then
  if btnp(0) then
   selected=max(1,selected-1)
   sfx(3)
  elseif btnp(1) then
   selected=min(3,selected+1)
   sfx(3)
  elseif btnp(5) then
   space_num=1
   start_space()
   sfx(1)
  end
 elseif state=="play" then
  if btnp(4) then
   state="menu"
   sfx(2)
  else
   update_movement()
  end
 elseif state=="eat" then
  if btnp(4) then
   state="menu"
   sfx(2)
   return
  end
  eat_frames+=1
  if eat_frames>=36 then
   if collected==3 then
    space_num=space_num%5+1
    start_space()
    sfx(1)
   else
    food_num+=1
    held_dir=-1
    hold_frames=0
    state="play"
   end
  end
 end
end

function food_sprites()
 if selected==2 then
  return steak_sprite,steak_outline
 end
 return leaf_sprite,leaf_outline
end

function draw_dino(x,y,scale)
 local sprites=dino_sprites[selected]
 local pair
 local flip=false
 if facing==0 or facing==1 then
  pair=1
  flip=facing==0
 elseif facing==3 then
  pair=3
 else
  pair=5
 end
 local frame=0
 if state=="play" and held_dir!=-1 and steps%2==1 then
  frame=1
 end
 local sprite=sprites[pair+frame]
 if scale==2 then
  local sx=(sprite%16)*8
  local sy=flr(sprite/16)*8
  sspr(sx,sy,24,24,x,y,32,32,flip)
 else
  spr(sprite,x,y,3,3,flip)
 end
end

function draw_menu()
 cls(3)
 center("dino snacks",5,7)
 center("pick a dino!",25,7)
 for i=1,3 do
  local x=8+(i-1)*40
  if i==selected then
   line(x+10,38,x+16,44,7)
   line(x+16,44,x+22,38,7)
  end
  local sprite=dino_sprites[i][1]
  sspr((sprite%16)*8,flr(sprite/16)*8,
   24,24,x,50,32,32)
 end
 center("< "..names[selected].." >",93,7)
 center("a:play",113,6)
end

function draw_ground()
 rectfill(0,16,127,127,4)
 for y=0,5 do
  for x=0,6 do
   local sx=8+x*16
   local sy=24+y*16
   if (x+y)%2==0 then
    rectfill(sx,sy,sx+15,sy+15,4)
   else
    rectfill(sx,sy,sx+15,sy+15,3)
   end
  end
 end
end

function draw_obstacles()
 for y=0,5 do
  for x=0,6 do
   local tile=sub(spaces[space_num].rows[y+1],x+1,x+1)
   local sprite=nil
   if tile=="#" then sprite=rock_sprite
   elseif tile=="o" then sprite=rock_alt_sprite
   elseif tile=="w" then sprite=pool_sprite end
   if sprite then
    spr(sprite,8+x*16,24+y*16,2,2)
   end
  end
 end
end

function draw_heart_effect()
 local cx=16+px*16
 local cy=24+py*16
 if eat_frames<18 then
  local y=max(17,cy-9-flr(eat_frames/3))
  spr(heart_sprite,cx-4,y)
 elseif eat_frames<34 then
  local burst=eat_frames-18
  local radius=2+flr(burst/2)
  local y=max(23,cy-13)
  local colour=burst<9 and 7 or 10
  line(cx-radius-1,y,cx-radius+1,y,colour)
  line(cx+radius-1,y,cx+radius+1,y,colour)
  line(cx,y-radius-1,cx,y-radius+1,colour)
  line(cx,y+radius-1,cx,y+radius+1,colour)
  pset(cx-radius+2,y-radius+2,colour)
  pset(cx+radius-2,y-radius+2,colour)
  pset(cx-radius+2,y+radius-2,colour)
  pset(cx+radius-2,y+radius-2,colour)
 end
end

function draw_hud()
 rectfill(0,0,127,15,1)
 line(0,15,127,15,5)
 local full,empty=food_sprites()
 for i=1,3 do
  local sprite=empty
  if i<=collected then
   sprite=full
  end
  sspr((sprite%16)*8,flr(sprite/16)*8,
   16,16,42+(i-1)*16,2,12,12)
 end
 print(space_num,116,4,7)
end

function draw_play()
 cls(4)
 draw_ground()
 draw_dino(4+px*16,20+py*16,1)
 draw_obstacles()
 if state=="play" then
  local food=spaces[space_num].food[food_num]
  local full=food_sprites()
  spr(full,food[1]*16+8,food[2]*16+24,2,2)
 end
 if state=="eat" then draw_heart_effect() end
 draw_hud()
end

function _draw()
 if state=="menu" then
  draw_menu()
 else
  draw_play()
 end
end
__gfx__
