pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--rekenspelletje
--door mathieu

function _init()
 options = {
  {"- +","- + x","- + x %"},
  {10, 20, 30},
  {1}
 }
 
 selector = {
  1,
  1,
  1
 }
 
 y_pos = 1
 
 nrs = {
 a = 1,
 b = 2
 }
 
 operator = "+"
 answer = nrs.a + nrs.b
 guess = 1
 
 range = 10
 roll_limit = 4
 
 btn_up_state = 3
 btn_dn_state = 19
 btn_lf_state = 5
 btn_rt_state = 21
 
 up_hold = false
 dn_hold = false
 lf_hold = false
 rt_hold = false
 
 treasure = 0
 treasure_max = 300
 
 bubble = {
 sx = 56,
 sy = 0,
 sw = 8,
 sh = 8,
 y = 10,
 x = 0,
 scale = 1
 }
 

end





-->8
--start

function update_start()
 
	if btnp(❎) then
	 sfx(0)
		_update60 = update_menu
		_draw = draw_menu
	end
end

function draw_start()
	cls()
	
	circfill(44, 64, 2, 10)
	print("druk    om te beginnen", 18, 62, 6)	
 
 --hartje
 spr(1, 63, 80)
end

_update60 = update_start
_draw = draw_start
-->8
--option

function update_menu()
 local lf_prsd = btn(⬅️)
 local rt_prsd = btn(➡️)
 
 if lf_hold and not lf_prsd then
  btn_lf_state = 5 
 end
 lf_hold = lf_prsd
 
 if rt_hold and not rt_prsd then
  btn_rt_state = 21
 end
 rt_hold = rt_prsd
 
 if btnp(➡️) then
  btn_rt_state = 22
  if selector[y_pos] < #options[y_pos] then
   sfx(3)
   selector[y_pos] += 1
  	end
 end
  	
 if btnp(⬅️) then
  btn_lf_state = 6
  if selector[y_pos] > 1 then
   sfx(3)
   selector[y_pos] -= 1
  	end
 end
 
 if btnp(⬇️) then
  if y_pos < 3 then
   sfx(1)
   y_pos += 1
  end
 end
 
 if btnp(⬆️) then
  if y_pos > 1 then
   sfx(2)
   y_pos -= 1
  end
 end
 
 if btnp(❎) and y_pos==3 then
  sfx(0)
  if selector[1] == 1 then
   roll_limit = 4
  elseif selector[1] == 2 then
   roll_limit = 5
  elseif selector[1] == 3 then
   roll_limit = 6
  end
  
  if selector[2] == 1 then
   range = 10
  elseif selector[2] == 2 then
   range = 20
  elseif selector[2] == 3 then
   range = 30
  end
  
  _update60 = update_game
		_draw = draw_game
 end
	
end

function draw_menu()
	cls()
	print("opties", 53, 10, 12)
	print(options[1][selector[1]],51,30,6)
	print(options[2][selector[2]],61,50,6)
	print("start",55,70, 6)
	
	if y_pos < 3 then
	 spr(btn_lf_state, 42, 8+20*y_pos)
	 spr(btn_rt_state, 80, 8+20*y_pos)
	else
	 line(52, 77, 76, 77, 12)
	end
end
-->8
--game

function update_game()
 local up_prsd = btn(⬆️)
 local dn_prsd = btn(⬇️)
 
 if up_hold and not up_prsd then
  btn_up_state = 3 
 end
 up_hold = up_prsd
 
 if dn_hold and not dn_prsd then
  btn_dn_state = 19
 end
 dn_hold = dn_prsd
 
 if btnp(⬆️) then
  sfx(3)
  btn_up_state = 4
  if guess < range then
   guess += 1
  end
 elseif btnp(⬇️) then
  sfx(3)
  btn_dn_state = 20
  if guess > 0 then
   guess -= 1
  end
 elseif btnp(❎) then
  if guess == answer then
   sfx(0)
   
   if treasure < treasure_max then
    treasure += 1
   end
   
   nrs.a = flr(rnd(range))+1
   nrs.b = flr(rnd(range))+1
   
   sort(nrs)
   
   roll = flr(rnd(roll_limit))+1
   -- +
   if roll == 1 or roll == 2 then
    operator = "+"
    while nrs.a+nrs.b >= range do
     nrs.a = flr(rnd(range))+1
     nrs.b = flr(rnd(range))+1
     sort(nrs)
    end
    answer = nrs.a + nrs.b
    
   -- - 
   elseif roll == 3 or roll == 4 then
    operator = "-"
    while nrs.a-nrs.b >=  range do
     nrs.a = flr(rnd(range))+1
     nrs.b = flr(rnd(range))+1
     sort(nrs)
    end 
    answer = nrs.a - nrs.b
     
   -- x 
   elseif roll == 5 then
    operator = "x"
    while nrs.a * nrs.b >= range do
     nrs.a = flr(rnd(range))+1
     nrs.b = flr(rnd(range))+1
     sort(nrs)
    end
    answer = nrs.a * nrs.b
    
   -- / 
   elseif roll == 6 then
    if nrs.b == 0 then
     nrs.b = 1
    end
    
    answer = flr(nrs.a/nrs.b)
    nrs.a = nrs.b * answer
    
    operator = "/"
   end
   guess = nrs.a
  else
   sfx(4)
   if treasure >= 0.2 then
    treasure -= 0.2
   end
  end
 end
end

function draw_game()
 cls()
 
 nrs_y = 15
 print(nrs.a, 15, nrs_y, 6)
 print(operator, 40, nrs_y, 6)
 print(nrs.b, 60, nrs_y, 15)
 print("=", 85, nrs_y, 6)
 print(guess, 100, nrs_y, 14)
 
 spr(btn_dn_state, 99, nrs_y+4)
 spr(btn_up_state, 99, nrs_y-8)
 
 coins(nrs.a, 0,30,6)
 coins(nrs.b,45,30,15)
 coins(guess,90,30,14)
 
 show_treasure(treasure)
end



function sort(list)
 if list.a < list.b then
  list.b, list.a = list.a, list.b
 end
end

function coins(n, x, y, c)
 x = x or 5
 y = y or 30
 c = c or 6
 rows = flr(n/5)
 for i=1, rows do
  for j=1, 5 do
   circfill(x+6*j,y+6*i,2,c)
   circfill(x-1+6*j,y-1+6*i,1,7)
  end
 end
 
 y += (rows+1)*6
 rest = n-5*rows
 for j=1, rest do
   circfill(x+6*j,y,2,c)
   circfill(x-1+6*j,y-1,1,7)
  end
end

function show_treasure(n)
 cols = flr(n/25)
 for x=1, cols do
  for y=1, 25 do
   spr(2, -5+10*x, 120-2*y)
  end
 end

 rest = n-25*cols
 for y=1, rest do
  spr(2, -5+10*(cols+1), 120-2*y)
 end 
end
