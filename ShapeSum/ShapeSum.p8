pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
-- shape sum
-- a picture-counting game
-- coin stack and sprite: mathieu's rekenspelletje
-- other sounds: mathieu's rekenspelletje
-- selection buzz: original

levels={9,12,15,20,30}
minimums={3,5,7,10,16}

-- piece: shape, x, y, size, orientation
-- 1 circle, 2 square, 3 rectangle,
-- 4 trapezium, 5 triangle, 6 narrow triangle,
-- 7 right triangle
-- orientation turns rectangles upright or triangles down
templates={
 {name="snowman",parts={
  {2,64,43,10},{1,64,56,13},{1,64,74,19}}},
 {name="heart",parts={
  {1,54,53,14},{1,74,53,14},{5,64,72,22,true}}},
 {name="house",parts={
  {5,64,49,24},{2,55,70,16},{2,73,70,16}}},
 {name="rocket",parts={
  {6,64,44,15},{3,64,58,18},{4,64,72,13}}},
 {name="butterfly",parts={
  {5,44,49,14},{5,84,49,14},
  {5,44,77,14,true},{5,84,77,14,true},
  {3,64,63,10}}},
 {name="robot",parts={
  {2,64,44,14},{3,64,62,18},
  {1,42,62,8},{1,86,62,8},
  {3,56,72,10},{3,72,72,10}}},
 {name="tree",parts={
  {5,64,43,13},{5,64,61,16},{5,64,80,16},
  {3,64,91,8},{1,42,67,8},{1,86,67,8}}},
 {name="flower",parts={
  {6,64,72,14},{1,64,48,8},{1,51,55,8},
  {1,77,55,8},{1,50,69,8},{1,78,69,8}}},
 {name="castle",parts={
  {2,43,67,17},{2,85,67,17},{3,64,74,16},
  {5,43,48,17},{5,85,48,17},
  {2,59,64,8},{2,69,64,8}}},
 {name="train",parts={
  {3,61,65,20},{3,88,65,13},{2,46,46,14},
  {3,87,55,9},{1,52,78,8},{1,72,78,8},
  {1,92,78,8}}},
 {name="garden",parts={
  {6,47,76,12},{6,81,76,12},
  {1,47,51,8},{1,36,61,8},{1,58,61,8},
  {1,81,51,8},{1,70,61,8},{1,92,61,8}}},
 {name="car",parts={
  {4,64,60,16},{1,50,76,12},{1,78,76,12}}},
 {name="stonehenge",parts={
  {3,64,43,24},{3,48,68,24,true},
  {3,80,68,24,true}}},
 {name="slide",parts={
  {7,55,66,24},{3,74,66,18,true},
  {2,87,72,12}}},
 {name="seesaw",parts={
  {3,64,54,30},{5,64,76,20}}},
 {name="stage",parts={
  {3,64,52,30},{5,48,74,20},
  {5,80,74,20}}}
}

-- template pools grow with the answer cap.
pools={
 {1,2,3,4,12,13,14,15,16},
 {1,2,3,4,5,12,13,14,15,16},
 {5,6,7,8,12,13,14,16},
 {5,6,7,8,9,10},
 {6,7,8,9,10,11}
}

function contains(t,v)
 for item in all(t) do
  if item==v then return true end
 end
 return false
end

function center(s,y,c)
 print(s,64-#s*2,y,c)
end

function make_puzzle()
 local pool=pools[level]
 local choice
 repeat
  choice=pool[flr(rnd(#pool))+1]
 until choice!=last_template
 last_template=choice
 picture=templates[choice]
 legend={}
 for part in all(picture.parts) do
  if not contains(legend,part[1]) then
   add(legend,part[1])
  end
 end
 while #legend<3 do
  local shape=flr(rnd(7))+1
  if not contains(legend,shape) then add(legend,shape) end
 end
 for i=#legend,2,-1 do
  local j=flr(rnd(i))+1
  legend[i],legend[j]=legend[j],legend[i]
 end
 shape_colours={}
 local available={6,11,12,14,15}
 for shape in all(legend) do
  local i=flr(rnd(#available))+1
  shape_colours[shape]=available[i]
  deli(available,i)
 end
 repeat
  values={}
  for shape in all(legend) do
   values[shape]=flr(rnd(5))+1
  end
  answer=0
  for part in all(picture.parts) do
   answer+=values[part[1]]
  end
 until answer>=minimums[level] and answer<=levels[level]
 guess=0
 wrong=false
 state="play"
end

function _init()
 state="menu"
 level=1
 coins=0
 last_template=0
 wrong=false
end

function _update60()
 if state=="menu" then
  if btnp(0) and level>1 then
   level-=1
   sfx(3)
  end
  if btnp(1) and level<5 then
   level+=1
   sfx(3)
  end
  if btnp(5) then
   sfx(0)
   srand(time())
   coins=0
   last_template=0
   make_puzzle()
  end
 elseif state=="play" then
  if btnp(4) then
   sfx(1)
   state="menu"
   return
  end
  if btnp(2) and guess<levels[level] then
   guess+=1
   wrong=false
   sfx(3)
  end
  if btnp(3) and guess>0 then
   guess-=1
   wrong=false
   sfx(3)
  end
  if btnp(5) then
   if guess==answer then
    coins=min(coins+1,300)
    sfx(0)
    state="correct"
   else
    wrong=true
    sfx(4)
   end
  end
 elseif state=="correct" then
  if btnp(5) then make_puzzle() end
  if btnp(4) then
   sfx(1)
   state="menu"
  end
 end
end

function outline_poly(points,colour)
 for i=1,#points do
  local a=points[i]
  local b=points[i%#points+1]
  line(a[1],a[2],b[1],b[2],colour)
 end
end

function draw_shape(shape,x,y,s,oriented)
 local r=flr(s/2)
 local colour=shape_colours[shape]
 if shape==1 then
  circ(x,y,r,colour)
 elseif shape==2 then
  rect(x-r,y-r,x+r,y+r,colour)
 elseif shape==3 then
  local w=flr(s*0.7)
  local h=flr(s*0.35)
  if oriented then w,h=h,w end
  rect(x-w,y-h,x+w,y+h,colour)
 elseif shape==4 then
  outline_poly({{x-r,y-r},{x+r,y-r},
   {x+r+4,y+r},{x-r-4,y+r}},colour)
 elseif shape==5 then
  local tip=oriented and y+r or y-r
  local base=oriented and y-r or y+r
  outline_poly({{x,tip},{x-r-3,base},{x+r+3,base}},colour)
 elseif shape==6 then
  local tip=oriented and y-r or y-r-3
  outline_poly({{x,tip},{x-flr(r/2),y+r},
   {x+flr(r/2),y+r}},colour)
 elseif shape==7 then
  outline_poly({{x-r,y+r},{x+r,y-r},{x+r,y+r}},colour)
 end
end

function draw_header()
 center("shape sum",2,6)
 print("max "..levels[level],96,2,6)
end

function draw_legend()
 for i=1,3 do
  local x=2+(i-1)*42
  local shape=legend[i]
  draw_shape(shape,x+10,22,8)
  print("="..values[shape],x+21,20,shape_colours[shape])
 end
end

-- Thin connectors sit behind the counted pieces.
function draw_links()
 local name=picture.name
 if name=="butterfly" then
  line(55,56,57,60,5)
  line(71,60,73,56,5)
  line(55,70,57,66,5)
  line(71,66,73,70,5)
 elseif name=="robot" then
  line(64,52,64,55,5)
  line(47,62,51,62,5)
  line(77,62,81,62,5)
 elseif name=="tree" then
  line(64,50,64,52,5)
  line(64,70,64,71,5)
  line(49,67,53,67,5)
  line(75,67,79,67,5)
 elseif name=="flower" then
  line(64,53,64,61,5)
  line(56,58,61,65,5)
  line(72,58,67,65,5)
 elseif name=="train" then
  line(46,54,46,57,5)
  line(87,59,87,60,5)
  line(47,73,96,73,5)
 elseif name=="garden" then
  line(47,56,47,66,5)
  line(81,56,81,66,5)
 end
end

function draw_picture()
 draw_links()
 for part in all(picture.parts) do
  draw_shape(part[1],part[2],part[3],part[4],part[5])
 end
end

-- Coin stack from rekenspelletje by mathieu.
function show_treasure(n)
 cols = flr(n/25)
 for x=1, cols do
  for y=1, 25 do
   spr(2, -5+10*x, 120-2*y)
  end
 end

 rest = n-25*cols
 for y=1, rest do
  spr(2, -5+10*(cols+1), 120-2*y)
 end
end

function draw_answer()
 print("total?",43,102,7)
 print(guess,guess>=10 and 90 or 92,102,10)
 line(90,99,93,96,6)
 line(93,96,96,99,6)
 line(90,110,93,113,6)
 line(93,113,96,110,6)
 if wrong then
  print("try again!",43,118,8)
 else
  print("a:check",43,118,6)
 end
 print("b:menu",95,118,6)
end

function _draw()
 cls(0)
 if state=="menu" then
  center("shape sum",21,6)
  center("count the shapes",42,7)
  center("maximum answer",59,6)
  center("< "..levels[level].." >",75,10)
  center("left/right:choose",99,5)
  center("a:start",113,7)
 else
  draw_header()
  draw_legend()
  draw_picture()
  show_treasure(coins)
  if state=="correct" then
   print("correct! +1",43,102,10)
   print("a:next",43,118,6)
   print("b:menu",95,118,6)
  else
   draw_answer()
  end
 end
end
