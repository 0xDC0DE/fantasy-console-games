pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
-- missing number: make the unicorn's target number
-- heart effect inspired by dino snacks
-- menu, answer, and sparkle sounds adapted from stringer

levels={10,15,20}
rainbow={8,9,10,11,12,13}
unicorn_sprites={0,5,10,128,133}

function center(s,y,c)
 print(s,64-#s*2,y,c)
end

function shuffle(t)
 for i=#t,2,-1 do
  local j=flr(rnd(i))+1
  t[i],t[j]=t[j],t[i]
 end
end

function new_round()
 local max_num=levels[level]
 repeat
  target=flr(rnd(max_num+1))
 until target!=last_target
 last_target=target
 repeat
  unicorn=flr(rnd(#unicorn_sprites))+1
 until unicorn!=last_unicorn
 last_unicorn=unicorn
 local plus={}
 local minus={}
 for a=0,max_num do
  local b=target-a
  if b>=0 and b<=max_num then add(plus,{a,1,b}) end
  b=a-target
  if b>=0 and b<=max_num then add(minus,{a,-1,b}) end
 end
 shuffle(plus)
 shuffle(minus)
 sums={plus[1],minus[1]}
 local rest={}
 for i=2,#plus do add(rest,plus[i]) end
 for i=2,#minus do add(rest,minus[i]) end
 shuffle(rest)
 add(sums,rest[1])
 shuffle(sums)
 step=1
 new_sum()
end

function new_sum()
 guess=0
 wrong=false
 state="play"
end

function _init()
 state="menu"
 level=1
 hearts=0
 last_target=-1
 last_unicorn=0
end

function start_heart_drop()
 -- Each 55-band tower rises to the header, then starts again.
 local row=hearts%55
 drop_x=1
 drop_y=max(0,101-row*2)
 drop_frames=max(8,flr((abs(drop_y-36)+3)/4))
 timer=0
 wrong=false
 state="drop"
 sfx(step==3 and 6 or 5)
end

function _update60()
 if state=="menu" then
  if btnp(0) and level>1 then level-=1 sfx(3) end
  if btnp(1) and level<3 then level+=1 sfx(3) end
  if btnp(5) then
   srand(time())
   hearts=0
   last_target=-1
   last_unicorn=0
   sfx(0)
   new_round()
  end
 elseif state=="play" then
  if btnp(4) then state="menu" sfx(1) return end
  if btnp(2) and guess<levels[level] then
   guess+=1 wrong=false sfx(3)
  end
  if btnp(3) and guess>0 then
   guess-=1 wrong=false sfx(3)
  end
  if btnp(5) then
   if guess==sums[step][3] then
    start_heart_drop()
   else
    wrong=true
    sfx(4)
   end
  end
 elseif state=="drop" then
  timer+=1
  if timer>drop_frames then
   timer=0
   state="burst"
   hearts+=1
   sfx(7)
  end
 elseif state=="burst" then
  timer+=1
  if timer==5 and step==3 then sfx(8) end
  if timer>=15 then
   if step==3 then
    new_round()
   else
    step+=1
    new_sum()
   end
  end
 end
end

function draw_unicorn(x,y,variant)
 spr(unicorn_sprites[variant],x,y,5,8)
end

function draw_heart(x,y)
 sspr(120,0,8,8,x,y,16,16)
end

function draw_tower()
 if hearts==0 then return end
 local height=(hearts-1)%55+1
 local cycle=flr((hearts-1)/55)
 for row=0,height-1 do
  local y=117-row*2
  local band=flr(row/5)
  local shade=band<=5 and band+1 or 11-band
  local c=rainbow[(shade+cycle-1)%6+1]
  rectfill(5,y,12,y+1,c)
 end
 line(5,117-(height-1)*2,12,117-(height-1)*2,7)
end

function draw_burst()
 local radius=2+flr(timer/2)
 local cx=drop_x+8
 local cy=drop_y+8
 local c=timer<9 and 7 or 10
 line(cx-radius-1,cy,cx-radius+1,cy,c)
 line(cx+radius-1,cy,cx+radius+1,cy,c)
 line(cx,cy-radius-1,cx,cy-radius+1,c)
 line(cx,cy+radius-1,cx,cy+radius+1,c)
 pset(cx-radius+2,cy-radius+2,c)
 pset(cx+radius-2,cy-radius+2,c)
 pset(cx-radius+2,cy+radius-2,c)
 pset(cx+radius-2,cy+radius-2,c)
end

function draw_sum()
 local s=sums[step]
 local left=tostr(s[1])
 local selected=tostr(guess)
 local x=64-18
 local c=state=="play" and 7 or 10
 print(left,x+flr((8-#left*4)/2),92,c)
 print(s[2]==1 and "+" or "-",x+12,92,c)
 print(selected,x+20+flr((8-#selected*4)/2),92,c)
 print("=",x+32,92,c)
 if state=="play" then
  -- Both arrows share the fixed answer slot's pixel center.
  local arrow_x=x+21
  pset(arrow_x+2,85,7)
  pset(arrow_x+1,86,7) pset(arrow_x+3,86,7)
  pset(arrow_x,87,7) pset(arrow_x+4,87,7)
  pset(arrow_x,101,7) pset(arrow_x+4,101,7)
  pset(arrow_x+1,102,7) pset(arrow_x+3,102,7)
  pset(arrow_x+2,103,7)
 end
end

function _draw()
 cls(0)
 if state=="menu" then
  center("missing number",7,6)
  draw_unicorn(44,15,1)
  center("make the number!",80,7)
  center("maximum number",89,6)
  center("< "..levels[level].." >",99,10)
  center("left/right:choose",109,5)
  center("a:start",119,7)
 else
  spr(15,2,1)
  print(hearts,13,2,10)
  center("missing number",2,6)
  print("max "..levels[level],99,2,6)
  draw_unicorn(36,12,unicorn)
  local result=tostr(target)
  print("\^w\^t"..result,88-#result*4,38,10)
  draw_sum()
  draw_tower()
  if state=="drop" then
   local t=min(1,timer/drop_frames)
   draw_heart(flr(5+(drop_x-5)*t),
    flr(36+(drop_y-36)*t))
  elseif state=="burst" then
   draw_burst()
  end
  if state=="play" then
   print(wrong and "try again!" or "a:check",39,119,wrong and 8 or 6)
  elseif state=="drop" then
   print("correct!",39,119,10)
  else
   print("rainbow!",39,119,10)
  end
  print("b:menu",98,119,6)
 end
end
