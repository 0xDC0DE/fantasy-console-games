 {"kl","r",{1},{8}},
 {"b","k",{1,5,7}},
 {"br","k",{1,5},{8}},
 {"d","k",{1,5,7},{6,3}},
 {"l","k",{1,7},{6,3}},
 {"r","s",{1,3},{5,7,6}},
 {"m","s",{5,7},{3,8,6}},
 {"m","d",{5,3},{6}},
 {"h","d",{5,7},{4,2,3}},
 {"h","s",{1,5,7},{6,3}},
 {"k","s",{1,4,7,8},{5,2}},
 {"k","l",{5,7},{3,8,6}},
 {"k","k",{5,6},{8,3}},
 {"r","k",{1,6,7},{5,3,8}},
 {"z","t",{4,5,8},{6,2,3}},
 {"z","n",{5,6,8},{3}},
 {"b","l",{1,5,6,7},{8,3}},
 {"p","l",{1,5,6},{3,7,8}},
 {"p","n",{5,6,7},{3}},
 {"p","p",{5,6},{8,3}},
 {"b","g",{7},{1,5}},
 {"b","t",{4,6,7,8},{5,2,3}},
 {"f","t",{4,3},{2,1,6}},
 {"g","t",{3,8},{1,7,6}},
 {"h","p",{1},{5,8}},
 {"d","n",{5,7,8},{1,3,6}},
 {"l","n",{1,6},{3}},
 {"l","m",{6},{7,3}},
 {"r","m",{5,6,7,8},{3}},
 {"r","p",{5,6,8},{3}},
 {"r","t",{5,7,8},{1,3,6}},
 {"t","n",{5,7,8}},
 {"z","l",{1,3,7,8},{5,6}},
 {"b","f",{5},{8}},
 {"d","f",{7,8}},
 {"d","l",{5}},
 {"r","r",{5}},
 {"v","r",{5,8}},
 {"v","t",{5}},
 {"s","p",{5},{6,3}},
 {"sn","p",{5}},
 {"tr","n",{3},{8,6}},
 {"pl","n",{3},{6}},
 {"pr","",{3},{6}},
 {"t","w",{4},{2}},
 {"k","d",{4},{2}},
 {"h","t",{4},{3,2,6,5,7}},
 {"p","w",{2},{4}},
 {"k","w",{2},{4}},
 {"kl","w",{2},{4}},
 {"fl","w",{2},{4}},
 {"bl","w",{2},{4}},
 {"r","w",{2},{4}},
 {"m","w",{4},{2}},
 {"l","w",{2},{4}},
 {"n","w",{2},{8,4}},
 {"b","r",{5,8},{1}},
 {"m","r",{5,8},{1}},
 {"n","r",{8}},
 {"k","r",{5,8},{1}},
 {"w","l",{8},{5,6,3}},
 {"v","s",{6,8},{3}},
 {"d","p",{8}},
 {"z","k",{5,8},{4,3,2,6}},
 {"l","f",{6,8},{5,3}},
 {"dr","",{8}},
 {"w","g",{8}},
 {"vl","g",{1,8}},
 {"br","f",{8}},
 {"f","ts",{8},{4,2}},
 {"n","ts",{8}},
 {"","ts",{8},{4,2}},
 {"n","t",{8},{1}},
 {"p","k",{7,8},{2,1,4}},
 {"f","r",{8}},
 {"sp","k",{8},{6,3}},
 {"st","r",{5,8},{1}},
 {"sp","r",{1,8}},
}
-- word bank end
rainbow={8,9,10,11,12,13,14}

-- hand-drawn lowercase font; g, j and p descend below the baseline
font={
 a={0,0,14,1,15,17,15},
 b={16,16,22,25,17,17,30},
 c={0,0,14,17,16,17,14},
 d={1,1,13,19,17,17,15},
 e={0,0,14,17,31,16,15},
 f={6,8,8,28,8,8,8},
 g={0,0,15,17,17,17,15,1,14},
 h={16,16,22,25,17,17,17},
 i={4,0,12,4,4,4,14},
 j={2,0,2,2,2,2,2,18,12},
 k={16,16,18,20,24,20,18},
 l={12,4,4,4,4,4,14},
 m={0,0,26,21,21,21,21},
 n={0,0,22,25,17,17,17},
 o={0,0,14,17,17,17,14},
 p={0,0,30,17,17,17,30,16,16},
 r={0,0,22,25,16,16,16},
 s={0,0,15,16,14,1,30},
 t={4,4,31,4,4,5,2},
 u={0,0,17,17,17,19,13},
 v={0,0,17,17,17,10,4},
 w={0,0,17,17,21,21,10},
 z={0,0,31,2,4,8,31},
 ["0"]={14,17,19,21,25,17,14},
 ["1"]={4,12,4,4,4,4,14},
 ["2"]={14,17,1,2,4,8,31},
 ["3"]={30,1,1,14,1,1,30},
 ["4"]={2,6,10,18,31,2,2},
 ["5"]={31,16,30,1,1,17,14},
 ["6"]={6,8,16,30,17,17,14},
 ["7"]={31,1,2,4,8,8,8},
 ["8"]={14,17,17,14,17,17,14},
 ["9"]={14,17,17,15,1,2,12},
 ["_"]={0,0,0,0,0,0,31},
 [":"]={0,4,4,0,4,4,0},
 ["!"]={4,4,4,4,4,0,4}
}

-- palette begin (generated by make_sprites.py)
function set_sprite_palette()
end
-- palette end

function draw_text(s,x,y,c,scale)
 for i=1,#s do
  local ch=sub(s,i,i)
  local glyph=font[ch]
  if glyph then
   for row=1,#glyph do
    for col=0,4 do
     if flr(glyph[row]/2^(4-col))%2==1 then
      local px=x+(i-1)*6*scale+col*scale
      local py=y+(row-1)*scale
      rectfill(px,py,px+scale-1,py+scale-1,c)
     end
    end
   end
  end
 end
end

function centered(s,y,c,scale)
 draw_text(s,64-flr((#s*6-1)*scale/2),y,c,scale)
end

function shuffle(t)
 for i=#t,2,-1 do
  local j=flr(rnd(i))+1
  t[i],t[j]=t[j],t[i]
 end
end

function incompatible(a,b)
 return (a==2 and b==4) or (a==4 and b==2)
     or (a==3 and b==6) or (a==6 and b==3)
end

function valid_pair(w,pair)
 if mode==1 then return pair==w[3] end
 for valid in all(w[3]) do
  if pair==valid then return true end
 end
 return false
end

function needs_two_choices(id)
 for limited in all(two_choice_only) do
  if id==limited then return true end
 end
 return false
end

function new_puzzle()
 choice_count=mode==1 and 3 or (word_correct<8 and 2 or 3)
 -- after eight short puzzles, start a fresh deck with every word
 if mode==2 and word_correct==8 then deck={} end
 if #deck==0 then
  local pool=mode==2 and word_correct<8 and three_letter_count or #active_words
  for i=1,pool do
   if mode==1 or word_correct<8 or not needs_two_choices(i) then
    add(deck,i)
   end
  end
  shuffle(deck)
 end
 local at=1
 if #deck>1 and deck[1]==last_word then at=2 end
 word_id=deck[at]
 deli(deck,at)
 last_word=word_id
 local w=active_words[word_id]
 local valid=mode==1 and {w[3]} or w[3]
 local correct=valid[flr(rnd(#valid))+1]
 local distractors={}
 for i=1,#pairs do
  local blocked=false
  if mode==2 and w[4] then
   for forbidden in all(w[4]) do
    if i==forbidden then blocked=true end
   end
  end
  if i!=correct and not blocked then add(distractors,i) end
 end
 shuffle(distractors)
 choices={correct}
 local good_count=1
 for candidate in all(distractors) do
  local fits=true
  for existing in all(choices) do
   if incompatible(candidate,existing) then fits=false end
  end
  local good=valid_pair(w,candidate)
  if good and good_count>=choice_count-1 then fits=false end
  if fits and #choices<choice_count then
   add(choices,candidate)
   if good then good_count+=1 end
  end
 end
 shuffle(choices)
 selected=flr(rnd(choice_count))+1
 wrong=false
 state="play"
 timer=0
end

function start_game()
 active_words=mode==1 and picture_words or word_words
 deck={}
 last_word=0
 solved=0
 word_correct=0
 new_puzzle()
end

function _init()
 srand(time())
 set_sprite_palette()
 palt(0,false)
 mode=1
 state="menu"
end

function _update60()
 if state=="menu" then
  if btnp(0) then mode=1 sfx(3) end
  if btnp(1) then mode=2 sfx(3) end
  if btnp(5) then start_game() sfx(0) end
 elseif state=="play" then
  if btnp(4) then state="menu" sfx(1) return end
  if btnp(0) then selected=max(1,selected-1) wrong=false end
  if btnp(1) then selected=min(choice_count,selected+1) wrong=false end
  if btnp(5) then
   if valid_pair(active_words[word_id],choices[selected]) then
    state="magic"
    timer=0
    sfx(0)
   else
    wrong=true
    sfx(1)
   end
  end
 else
  timer+=1
  if timer==32 then sfx(2) end
  if timer==62 or timer==80 or timer==98 then sfx(3) end
  if timer==124 then
   solved+=1
   if mode==2 then word_correct+=1 end
  end
  if timer>=145 then new_puzzle() end
 end
end

function heart(x,y,c)
 pset(x-2,y-2,c) pset(x+2,y-2,c)
 rectfill(x-3,y-1,x+3,y,c)
 rectfill(x-2,y+1,x+2,y+1,c)
 rectfill(x-1,y+2,x+1,y+2,c)
 pset(x,y+3,c)
end

function star(x,y,c)
 line(x-2,y,x+2,y,c)
 line(x,y-2,x,y+2,c)
 pset(x-1,y-1,7) pset(x+1,y+1,7)
end

function selector(x,y,c)
 -- symmetric 5x3 v
 pset(x-2,y,c) pset(x+2,y,c)
 pset(x-1,y+1,c) pset(x+1,y+1,c)
 pset(x,y+2,c)
end

function draw_menu()
 centered("tweeklanken",3,13,1)
 centered("kies een spel",19,7,1)
 sspr(0,0,32,32,16,38,32,32)
 draw_text("n__s",73,48,7,2)
 draw_text("plaatjes",9,81,mode==1 and 7 or 6,1)
 draw_text("woorden",76,81,mode==2 and 7 or 6,1)
 selector(mode==1 and 32 or 96,74,10)
 centered("a: start",116,6,1)
end

function draw_rainbow_counter()
 if solved==0 then return end
 local progress=(solved-1)%30+1
 local cycle=flr((solved-1)/30)
 for i=0,min(progress,15)-1 do
  local y=113-i*5
  rectfill(119,y,124,y+3,rainbow[(i+cycle)%7+1])
 end
 for i=0,max(0,progress-15)-1 do
  local y=113-i*5
  rectfill(3,y,8,y+3,rainbow[(i+cycle)%7+1])
 end
end

function draw_magic()
 -- the chosen pair sends a heart to the picture
 if timer<32 then
  local y=95-flr(timer*49/32)
  heart(64,y,14)
 elseif timer<62 then
  local r=flr((timer-32)/3)
  for i=1,8 do
   local a=i/8
   local x=64+flr(cos(a)*r*2)
   local y=53+flr(sin(a)*r)
   star(x,y,rainbow[(i+flr(timer/6))%7+1])
  end
 elseif timer<124 then
  -- three sparkles hop above the picture, one after another
  for i=0,2 do
   local t=timer-62-i*18
   if t>=0 and t<26 then
    local x=52+i*12
    local y=76-flr(34*abs(sin(t/52)))
    star(x,y,rainbow[(i*2+flr(timer/6))%7+1])
    if t>7 and t<19 then
     pset(x-3,y+5,14) pset(x+3,y+6,7)
    end
   end
  end
 else
  for i=0,6 do
   local x=38+i*9
   local y=66-flr(12*sin(i/12))
   star(x,y,rainbow[i+1])
  end
  heart(64,49,14)
 end
end

function draw_word_prompt(w)
 local x=64-flr(((#w[1]+2+#w[2])*6-1)*3/2)
 local pair=pairs[choices[selected]]
 local shown=state=="magic" and pair or "__"
 local glow=rainbow[flr(timer/6)%7+1]
 draw_text(w[1],x,41,7,3)
 draw_text(shown,x+#w[1]*18,41,state=="magic" and glow or 7,3)
 draw_text(w[2],x+(#w[1]+2)*18,41,7,3)
end

function draw_word_magic()
 -- the answer flies to the word, then lights a rainbow underline
 if timer<32 then
  local start_x=choice_count==2 and (selected==1 and 42 or 86)
                  or 26+(selected-1)*38
  heart(start_x+flr((64-start_x)*timer/32),
        91-flr(timer*23/32),14)
 elseif timer<62 then
  local r=2+flr((timer-32)/3)
  for i=0,7 do
   local a=i/8
   star(64+flr(cos(a)*r*2),70+flr(sin(a)*r),
        rainbow[(i+flr(timer/5))%7+1])
  end
 elseif timer<124 then
  for i=0,2 do
   local t=timer-62-i*18
   if t>=0 and t<26 then
    local x=35+i*29
    local y=84-flr(42*abs(sin(t/52)))
    star(x,y,rainbow[(i*2+flr(timer/6))%7+1])
    if t>7 and t<19 then pset(x-3,y+5,14) end
   end
  end
 else
  for i=0,6 do
   star(38+i*9,83-flr(9*abs(sin(i/12))),rainbow[i+1])
  end
 end
 if timer>=32 then
  local bands=min(7,1+flr((timer-32)/5))
  for i=0,bands-1 do
   rectfill(37+i*8,72,43+i*8,73,rainbow[i+1])
  end
 end
end

function _draw()
 cls(1)
 if state=="menu" then draw_menu() return end
 centered("tweeklanken",2,13,1)
 local count=tostr(solved)
 draw_text(count,127-#count*6,2,14,1)
 draw_rainbow_counter()

 local w=active_words[word_id]
 if mode==1 then
  local pair=pairs[w[3]]
  local gap=state=="magic" and pair or "__"
  centered(w[1]..gap..w[2],18,state=="magic" and 10 or 7,2)
  local slot=w[4]
  sspr((slot%4)*32,flr(slot/4)*32,32,32,48,43,32,32)
 else
  centered("woorden",18,13,1)
  draw_word_prompt(w)
 end

 for i=1,choice_count do
  local x=choice_count==2 and (i==1 and 42 or 86)
          or 26+(i-1)*38
  local active=i==selected
  draw_text(pairs[choices[i]],x-11,96,active and 7 or 6,2)
  if active and state=="play" then selector(x,89,wrong and 8 or 10) end
 end
 if state=="magic" then
  if mode==1 then draw_magic() else draw_word_magic() end
  centered(mode==2 and word_correct==8 and timer>=124
           and "3 opties!" or "super!",119,10,1)
 else
  centered(wrong and "probeer nog eens" or "a: kies",119,wrong and 8 or 6,1)
 end
end
__gfx__
