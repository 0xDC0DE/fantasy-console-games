pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
-- tweeklanken: choose the missing letter pair
-- 32x32 picture slots: 4 columns by 4 rows

pairs={"eu","au","ei","ou","oe","ij","ui","ie"}
-- prefix, suffix, pair number, picture slot
picture_words={
 {"n","s",1,0},{"d","r",1,1},
 {"p","w",2,2},{"","to",2,3},{"bl","w",2,4},
 {"k","",3,5},{"g","t",3,6},{"tr","n",3,7},
 {"t","w",4,8},{"k","s",4,9},{"k","d",4,10},
 {"b","k",5,11},{"p","s",5,12},
 {"b","l",6,13},{"","s",6,14}
}
-- word bank begin (generated by word_bank.py)
three_letter_count=19
two_choice_only={7}
word_words={
 {"","d",{4},{5,2,3,7,8}},
 {"","f",{5}},
 {"","k",{3},{6,8}},
 {"","l",{7},{6,8,3}},
 {"","n",{5}},
 {"","s",{6},{3}},
 {"","t",{7},{4,3,8,2,6,5}},
 {"b","",{1,5,6,7},{3,8}},
 {"d","",{5,8,6},{3}},
 {"h","",{4,5,6},{1,7,3,2}},
 {"j","",{4,6},{1,5,2,3}},
 {"k","",{4,5,3},{1,7,2,6}},
 {"l","",{7},{3,6,4,2}},
 {"m","",{5,6},{7,8,3}},
 {"n","",{4},{1,2}},
 {"r","",{6},{1,5,3,7}},
 {"t","",{5},{6,7,8,3}},
 {"w","",{4,3,6,8},{7,2}},
 {"z","",{4,3,6,8},{2}},
 {"n","s",{1,8},{5}},
