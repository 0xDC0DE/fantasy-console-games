pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
-- countnumbers: read a number, then count out objects
-- sounds adapted from the other homemade math games

levels={5,9}
icons={0,2,4,6,8,10}

-- seven by nine numerals, drawn at two pixels per source pixel
digits={
 [1]={"0011000","0111000","0011000","0011000","0011000","0011000","0011000","0011000","1111111"},
 [2]={"0111110","1100011","0000011","0000110","0001100","0011000","0110000","1100000","1111111"},
 [3]={"0111110","1100011","0000011","0000110","0011110","0000011","0000011","1100011","0111110"},
 [4]={"0001110","0011110","0110110","1100110","1100110","1111111","0000110","0000110","0000110"},
 [5]={"1111111","1100000","1100000","1111110","0000011","0000011","0000011","1100011","0111110"},
 [6]={"0011110","0110000","1100000","1111110","1100011","1100011","1100011","1100011","0111110"},
 [7]={"1111111","0000011","0000110","0000110","0001100","0001100","0011000","0011000","0011000"},
 [8]={"0111110","1100011","1100011","1100011","0111110","1100011","1100011","1100011","0111110"},
 [9]={"0111110","1100011","1100011","1100011","0111111","0000011","0000011","0000110","0111100"}
}

function center(s,y,c)
 print(s,64-#s*2,y,c)
end

function big_number(n,x,y,c)
 local rows=digits[n]
 for ry=1,9 do
  local row=rows[ry]
  for rx=1,7 do
   if sub(row,rx,rx)=="1" then
    rectfill(x+(rx-1)*2,y+(ry-1)*2,
     x+(rx-1)*2+1,y+(ry-1)*2+1,c)
   end
  end
 end
end

function choose_round()
 local maximum=levels[level]
 repeat target=flr(rnd(maximum))+1
 until target!=last_target
 last_target=target
 repeat icon=flr(rnd(#icons))+1
 until icon!=last_icon
 last_icon=icon
 count=0
 wrong=false
 wrong_count=0
 entry_timer=0
 exit_timer=0
 state="play"
end

function _init()
 level=1
 state="menu"
 last_target=0
 last_icon=0
 count=0
 timer=0
end

function _update60()
 if state=="menu" then
  if (btnp(0) or btnp(3)) and level>1 then
   level-=1 sfx(3)
  elseif (btnp(1) or btnp(2)) and level<2 then
   level+=1 sfx(3)
  end
  if btnp(5) then
   srand(time())
   last_target=0
   last_icon=0
   sfx(0)
   choose_round()
  end
 elseif state=="play" then
  if btnp(4) then state="menu" sfx(1) return end
  if (btnp(2) or btnp(1)) and count<levels[level] then
   count+=1
   entry_timer=8
   exit_timer=0
   wrong=false
   sfx(3)
  elseif (btnp(3) or btnp(0)) and count>0 then
   exit_index=count
   count-=1
   exit_timer=8
   entry_timer=0
   wrong=false
   sfx(3)
  end
  if btnp(5) then
   if count==target then
    state="celebrate"
    effect=flr(rnd(4))+1
    timer=0
    if effect==1 then sfx(5)
    elseif effect==2 then sfx(6)
    elseif effect==3 then sfx(7)
    else sfx(8) end
   else
    wrong=true
    wrong_count=min(4,wrong_count+1)
    sfx(4)
   end
  end
  if entry_timer>0 then entry_timer-=1 end
  if exit_timer>0 then exit_timer-=1 end
 elseif state=="celebrate" then
  if btnp(4) then state="menu" sfx(1) return end
  timer+=1
  if timer>=30 then choose_round() end
 end
end

-- Positions fill the top and bottom of each column in turn.
function object_position(i,maximum)
 local column=flr((i-1)/2)
 local row=(i-1)%2
 if maximum==5 then
  return 24+column*30,49+row*29,20
 end
 return 10+column*23,54+row*26,16
end

function object_sprite(i,maximum,kind,scale,dy,height)
 local x,y,size=object_position(i,maximum)
 size=max(1,flr(size*scale))
 local h=height or size
 x+=flr((object_position_size(maximum)-size)/2)
 y=y+flr((object_position_size(maximum)-h)/2)
 y+=dy or 0
 sspr((icons[kind]%16)*8,flr(icons[kind]/16)*8,
  16,16,x,y,size,h)
end

function object_position_size(maximum)
 return maximum==5 and 20 or 16
end

function draw_hint(maximum)
 for i=1,target do
  local x,y,size=object_position(i,maximum)
  circ(x+flr(size/2),y+flr(size/2),flr(size/2)+1,6)
 end
end

function draw_objects(n,maximum,kind)
 for i=1,n do
  if state=="celebrate" then
   if effect==1 then
    if timer<9 then
     object_sprite(i,maximum,kind,1,0)
    else
     local x,y,size=object_position(i,maximum)
     local cx=x+flr(size/2)
     local cy=y+flr(size/2)
     local r=flr((timer-9)/2)+2
     local c=timer<20 and 10 or 7
     pset(cx-r,cy,c) pset(cx+r,cy,c)
     pset(cx,cy-r,c) pset(cx,cy+r,c)
     pset(cx-r,cy-r,c) pset(cx+r,cy-r,c)
     pset(cx-r,cy+r,c) pset(cx+r,cy+r,c)
    end
   elseif effect==2 then
    object_sprite(i,maximum,kind,1,-flr(timer*1.7))
   elseif effect==3 then
    local size=object_position_size(maximum)
    local h=max(1,size-flr(timer*size/30))
    local x,y=object_position(i,maximum)
    sspr((icons[kind]%16)*8,flr(icons[kind]/16)*8,
     16,16,x,y+size-h,size,h)
   else
    object_sprite(i,maximum,kind,max(0.05,1-timer/30),0)
   end
  elseif state=="play" and entry_timer>0 and i==count then
   object_sprite(i,maximum,kind,1+entry_timer/24,0)
  else
   object_sprite(i,maximum,kind,1,0)
  end
 end
 if state=="play" and exit_timer>0 then
  object_sprite(exit_index,maximum,kind,exit_timer/8,0)
 end
end

function _draw()
 cls(0)
 if state=="menu" then
  center("countnumbers",3,6)
  center("count to the number!",15,7)
  local maximum=levels[level]
  local preview_icon=level==1 and 1 or 2
  center("left/right:choose",37,5)
  draw_objects(maximum,maximum,preview_icon)
  center("maximum number",101,6)
  center("< "..maximum.." >",110,10)
  center("x:start",120,7)
 else
  center("countnumbers",2,6)
  print("max "..levels[level],99,2,6)
  big_number(target,57,20,10)
  draw_objects(count,levels[level],icon)
  if state=="play" and wrong_count>=4 then
   draw_hint(levels[level])
  end
  if state=="celebrate" then
   center("great counting!",108,10)
  elseif wrong_count>=4 then
   center("follow the outlines",108,6)
  elseif wrong then
   center("try again!",108,8)
  else
   center("up/down:count",108,5)
  end
  print(state=="celebrate" and "" or "x:check",41,119,6)
  print("o:menu",96,119,6)
 end
end
