pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
-- mathsplit
-- a number-bond subtraction game
-- coin stack and sprite: mathieu's rekenspelletje
-- other sounds: mathieu's rekenspelletje
-- selection buzz: original

levels={7,10}

function center(s,y,c)
 print(s,64-#s*2,y,c)
end

function make_puzzle()
 repeat
  top=flr(rnd(levels[level]))+1
  given=flr(rnd(top+1))
 until top!=last_top or given!=last_given
 last_top=top
 last_given=given
 answer=top-given
 guess=0
 wrong=false
 state="play"
end

function _init()
 state="menu"
 level=1
 coins=0
 last_top=-1
 last_given=-1
 wrong=false
end

function _update60()
 if state=="menu" then
  if btnp(0) and level>1 then
   level-=1
   sfx(3)
  end
  if btnp(1) and level<2 then
   level+=1
   sfx(3)
  end
  if btnp(5) then
   sfx(0)
   srand(time())
   coins=0
   last_top=-1
   last_given=-1
   make_puzzle()
  end
 elseif state=="play" then
  if btnp(4) then
   sfx(1)
   state="menu"
   return
  end
  if btnp(2) and guess<levels[level] then
   guess+=1
   wrong=false
   sfx(3)
  end
  if btnp(3) and guess>0 then
   guess-=1
   wrong=false
   sfx(3)
  end
  if btnp(5) then
   if guess==answer then
    coins=min(coins+1,300)
    sfx(0)
    state="correct"
   else
    wrong=true
    sfx(4)
   end
  end
 elseif state=="correct" then
  if btnp(5) then make_puzzle() end
  if btnp(4) then
   sfx(1)
   state="menu"
  end
 end
end

function number_in_node(n,x,y,c)
 local s=tostr(n)
 print(s,x-#s*2,y-2,c)
end

function draw_box(x,y,c)
 line(x-10,y-13,x+10,y-13,c)
 line(x-10,y+13,x+10,y+13,c)
 line(x-13,y-10,x-13,y+10,c)
 line(x+13,y-10,x+13,y+10,c)
 line(x-12,y-11,x-11,y-12,c)
 line(x+11,y-12,x+12,y-11,c)
 line(x-12,y+11,x-11,y+12,c)
 line(x+11,y+12,x+12,y+11,c)
end

function draw_tree()
 -- The branches meet the outside of each number box.
 line(57,50,40,64,5)
 line(71,50,88,64,5)
 draw_box(64,37,6)
 draw_box(34,77,12)
 draw_box(94,77,state=="correct" and 10 or 11)
 number_in_node(top,64,37,7)
 number_in_node(given,34,77,7)
 number_in_node(guess,94,77,state=="correct" and 10 or 7)
 if state=="play" then
  line(90,60,94,57,6)
  line(94,57,98,60,6)
  line(90,94,94,97,6)
  line(94,97,98,94,6)
 end
end

-- Coin stack from rekenspelletje by mathieu.
function show_treasure(n)
 cols = flr(n/25)
 for x=1, cols do
  for y=1, 25 do
   spr(2, -5+10*x, 120-2*y)
  end
 end

 rest = n-25*cols
 for y=1, rest do
  spr(2, -5+10*(cols+1), 120-2*y)
 end
end

function _draw()
 cls(0)
 if state=="menu" then
  center("mathsplit",21,6)
  center("fill the missing part",42,7)
  center("maximum number",59,6)
  center("< "..levels[level].." >",75,10)
  center("left/right:choose",99,5)
  center("a:start",113,7)
 else
  center("mathsplit",2,6)
  print("max "..levels[level],96,2,6)
  draw_tree()
  show_treasure(coins)
  if state=="correct" then
   center("correct! +1",102,10)
   print("a:next",43,118,6)
  else
   center(top.." - "..given.." = ?",102,7)
   print(wrong and "try again!" or "a:check",43,118,wrong and 8 or 6)
  end
  print("b:menu",95,118,6)
 end
end
