pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
-- color mix
-- a primary-colour mixing game
-- coin stack and sprite: mathieu's rekenspelletje
-- other sounds: mathieu's rekenspelletje
-- selection buzz: original

-- red=8, orange=9, yellow=10,
-- green=11, blue=12, purple=13
mixes={
 {10,12,11},
 {10,8,9},
 {8,12,13}
}

function center(s,y,c)
 print(s,64-#s*2,y,c)
end

function make_puzzle()
 local choice
 repeat
  choice=flr(rnd(#mixes))+1
 until choice!=last_mix
 last_mix=choice
 local mix=mixes[choice]
 top_left=mix[1]
 top_right=mix[2]
 if rnd(1)<0.5 then
  top_left,top_right=top_right,top_left
 end
 answer=mix[3]
 options={9,11,13}
 for i=#options,2,-1 do
  local j=flr(rnd(i))+1
  options[i],options[j]=options[j],options[i]
 end
 selected=1
 wrong=false
 state="play"
end

function _init()
 state="menu"
 coins=0
 last_mix=0
 wrong=false
end

function _update60()
 if state=="menu" then
  if btnp(5) then
   sfx(0)
   srand(time())
   coins=0
   last_mix=0
   make_puzzle()
  end
 elseif state=="play" then
  if btnp(4) then
   sfx(1)
   state="menu"
   return
  end
  if btnp(0) and selected>1 then
   selected-=1
   wrong=false
   sfx(3)
  end
  if btnp(1) and selected<3 then
   selected+=1
   wrong=false
   sfx(3)
  end
  if btnp(5) then
   if options[selected]==answer then
    coins=min(coins+1,300)
    sfx(0)
    state="correct"
   else
    wrong=true
    sfx(4)
   end
  end
 elseif state=="correct" then
  if btnp(5) then make_puzzle() end
  if btnp(4) then
   sfx(1)
   state="menu"
  end
 end
end

function color_circle(x,y,r,c)
 circfill(x,y,r,c)
 circ(x,y,r,7)
end

function draw_plus(x,y)
 line(x-2,y,x+2,y,6)
 line(x,y-2,x,y+2,6)
end

function draw_selector(x,y,c)
 pset(x-2,y,c)
 pset(x+2,y,c)
 pset(x-1,y+1,c)
 pset(x+1,y+1,c)
 pset(x,y+2,c)
end

function draw_puzzle()
 color_circle(44,39,12,top_left)
 color_circle(84,39,12,top_right)
 draw_plus(64,39)
 for i=1,3 do
  local x=28+(i-1)*36
  color_circle(x,78,11,options[i])
 end
 local x=28+(selected-1)*36
 draw_selector(x,59,state=="correct" and 10 or 7)
end

-- Coin stack from rekenspelletje by mathieu.
function show_treasure(n)
 cols = flr(n/25)
 for x=1, cols do
  for y=1, 25 do
   spr(2, -5+10*x, 120-2*y)
  end
 end

 rest = n-25*cols
 for y=1, rest do
  spr(2, -5+10*(cols+1), 120-2*y)
 end
end

function _draw()
 cls(0)
 if state=="menu" then
  center("color mix",19,6)
  center("mix the colors!",42,7)
  color_circle(44,72,9,10)
  color_circle(84,72,9,12)
  draw_plus(64,72)
  center("which color?",94,6)
  center("x:start",113,7)
 else
  center("color mix",2,6)
  draw_puzzle()
  show_treasure(coins)
  if state=="correct" then
   center("correct! +1",105,10)
   print("x:next",43,118,6)
  else
   center(wrong and "try again!" or "left/right:choose",105,wrong and 8 or 6)
   print("x:check",43,118,6)
  end
  print("o:menu",95,118,6)
 end
end
