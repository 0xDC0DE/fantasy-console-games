pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
-- turtles and hare
-- 0 cursor, 1 select, 2 unselect, 3 invalid, 4 finish
level_data={{"...","...","br.",2212},
{"...","...",".yb",1176},
{".r.","...",".p.",153},
{"...","...","yrb",3076},
{"...","...","byr",928},
{"...","...","ybr",1608},
{"...","...","ybr",142},
{"r.p","...","g..",1796},
{"rby","...","...",396},
{"r.y","p.g","...",15},
{"p.g","...","y.r",1156},
{"r.y","...","g.p",2572},
{"...","...","byh",420},
{"yhp","...","..g",1124},
{"g.y",".h.",".r.",2436},
{"b.p","...",".gh",1665},
{".h.","...","br.",1348},
{".b.","...","gyh",408},
{"rh.","...","gb.",554},
{".h.","...","ybr",1029},
{"...",".h.","brg",1172},
{"...",".r.","bgh",2200},
{"..r","h.y","..b",1035},
{"...","yp.","gh.",108},
{".h.",".y.","bpr",549},
{"ghb","...","rp.",3112},
{"ghr","...","pb.",300},
{"r.y",".h.","gbp",2880},
{"bhy","gp.",".r.",2328},
{"rhg","...","y.p",649},
{"r.y",".bh","g.p",76},
{"hp.","rb.","...",154},
{"bh.","...","ygr",553},
{"g.p",".h.","r.b",1068},
{"hgp","...",".by",141},
{"y.r","p.g",".h.",39},
{"yhr","...","pbg",368},
{"y.r","b.g","p.h",801},
{"byg","...","phr",178},
{"rby","...","ghp",588},
{"pr.","gh.","yb.",1052},
{"rhp","...","gby",240},
{"yhr","pb.","g..",1424},
{"r.b","y.g","p.h",780},
{"rph","...","gyb",1728},
{"b..","r.y","hgp",2073},
{"p.g","b.h","y.r",308},
{"...","phb","ygr",556}}


names={"easy","medium","hard","expert"}
difficulty_colors={3,12,2,15}
sprite_id={g=0,b=4,r=8,y=12,p=64,h=68}
goal_pos={g=0,h=1,p=2,r=6,b=7,y=8}
goal_col={g=3,h=6,p=2,r=5,b=9,y=7}
rainbow={5,6,7,3,9,2}
big_font={
 a="25755",d="65556",e="74647",h="55755",i="72227",
 m="57755",p="65644",r="65655",s="74717",t="72222",
 u="55557",x="55255",y="55222",
 ["0"]="75557",["1"]="26227",["2"]="71247",
 ["3"]="71217",["4"]="55711",["5"]="74717",
 ["6"]="74657",["7"]="71122",["8"]="75757",
 ["9"]="75717",["/"]="11244"
}
dx={-1,1,0,0}
dy={0,0,-1,1}

function _init()
 local colors={138,1,2,3,4,8,9,10,11,12,13,139,140,141,142,136}
 for i=0,15 do pal(i,colors[i+1],1) end
 palt(0,true)
 state="menu"
 difficulty=1
 menu_x=0
 menu_y=1
 level_num=1
 cx=0
 cy=0
 selected=nil
 animals={}
 tick=0
 bad_timer=0
end

function center(s,y,c)
 print(s,64-#s*2,y,c)
end

function big_text(s,y,color)
 local x=flr((128-(#s*12-3))/2)
 for i=1,#s do
  local glyph=big_font[sub(s,i,i)]
  for row=1,5 do
   local bits=tonum(sub(glyph,row,row))
   for col=0,2 do
    if band(bits,2^(2-col))!=0 then
     local px=x+(i-1)*12+col*3
     local py=y+(row-1)*3
     rectfill(px,py,px+2,py+2,color)
    end
   end
  end
 end
end

function wall_bit(x,y,nx,ny)
 if nx>x then return y*2+x end
 if nx<x then return y*2+nx end
 if ny>y then return 6+y*3+x end
 return 6+ny*3+x
end

function fenced(x,y,nx,ny)
 local bit=wall_bit(x,y,nx,ny)
 return band(walls,2^bit)!=0
end

function occupant(x,y)
 for i=1,#animals do
  if animals[i].x==x and animals[i].y==y then return i end
 end
 return nil
end

function load_level(n)
 local item=level_data[n]
 animals={}
 walls=item[4]
 for y=0,2 do
  for x=0,2 do
   local char=sub(item[y+1],x+1,x+1)
   if char!="." then add(animals,{kind=char,x=x,y=y}) end
  end
 end
 cx=animals[1].x
 cy=animals[1].y
 selected=nil
 moving=nil
 bad_timer=0
 state="game"
end

function begin_level(n)
 level_num=n
 intro_timer=150
 state="intro"
end

function open_quit()
 quit_return=state
 quit_yes=false
 state="quit"
 sfx(2)
end

function quit_or_restart()
 if btn(5) then
  load_level(level_num)
  sfx(2)
 else
  open_quit()
 end
end

function solved()
 for animal in all(animals) do
  if animal.y*3+animal.x!=goal_pos[animal.kind] then return false end
 end
 return true
end

function invalid()
 bad_timer=16
 sfx(3)
end

function try_move(dir)
 local animal=animals[selected]
 local nx=animal.x+dx[dir]
 local ny=animal.y+dy[dir]
 if nx<0 or nx>2 or ny<0 or ny>2 then invalid() return end
 if fenced(animal.x,animal.y,nx,ny) then invalid() return end
 local other=occupant(nx,ny)
 if other then
  if animal.kind!="h" or animals[other].kind=="h" then invalid() return end
  local lx=nx+dx[dir]
  local ly=ny+dy[dir]
  if lx<0 or lx>2 or ly<0 or ly>2 or occupant(lx,ly)
   or fenced(nx,ny,lx,ly) then invalid() return end
  nx=lx
  ny=ly
 end
 moving={index=selected,fx=animal.x,fy=animal.y,tx=nx,ty=ny,t=0,dur=animal.kind=="h" and 12 or 8}
 animal.x=nx
 animal.y=ny
 cx=nx
 cy=ny
 state="moving"
 sfx(0)
end

function direction_press()
 local pressed=nil
 local held=0
 for d=1,4 do
  if btn(d-1) then held+=1 end
  if btnp(d-1) then pressed=d end
 end
 if pressed and held>1 then return -1 end
 return pressed
end

function update_game()
 if btnp(4) then
  quit_or_restart()
  return
 end
 if bad_timer>0 then bad_timer-=1 end
 if btnp(5) then
  if selected then
   selected=nil
   sfx(2)
  else
   selected=occupant(cx,cy)
   if selected then sfx(1) else invalid() end
  end
  return
 end
 local dir=direction_press()
 if dir==-1 then invalid() return end
 if not dir then return end
 if selected then
  try_move(dir)
 else
  local nx=cx+dx[dir]
  local ny=cy+dy[dir]
  if nx>=0 and nx<=2 and ny>=0 and ny<=2 then
   cx=nx
   cy=ny
   sfx(0)
  else invalid() end
 end
end

function update_tutorial()
 if btnp(5) or btnp(4) then state="menu" return end
 tutorial_frame+=1
 local t=flr(tutorial_frame*2/5)
 if t!=flr((tutorial_frame-1)*2/5) then
  if t==30 or t==60 or t==151 or t==181 or t==241 or t==271 then sfx(0) end
  if t==90 then sfx(3) end
  if t==121 then sfx(1) end
  if t==211 or t==301 then sfx(4) end
 end
 if t>350 then state="menu" end
end

function move_menu(dir)
 local nx=menu_x+dx[dir]
 local ny=menu_y+dy[dir]
 if ny<1 or ny>2 then return end
 if ny==2 then nx=min(nx,1) end
 if nx<0 or nx>2 then return end
 if nx!=menu_x or ny!=menu_y then
  menu_x=nx
  menu_y=ny
  sfx(0)
 end
end

function _update60()
 tick+=1
 if state=="menu" then
  local dir=direction_press()
  if dir and dir>0 then move_menu(dir) end
  if btnp(5) then
   if menu_y==2 and menu_x==1 then
    state="tutorial" tutorial_frame=0 sfx(1)
   else
    difficulty=menu_y==1 and menu_x+1 or 4
    begin_level(1+(difficulty-1)*12) sfx(1)
   end
  end
  if btnp(4) then
   menu_x=1 menu_y=2
   state="tutorial" tutorial_frame=0 sfx(1)
  end
 elseif state=="intro" then
  if btnp(4) or btnp(5) then
   load_level(level_num)
  else
   intro_timer-=1
   if intro_timer<=0 then load_level(level_num) end
  end
 elseif state=="game" then
  update_game()
 elseif state=="moving" then
  if btnp(4) then quit_or_restart() return end
  moving.t+=1
  if moving.t>=moving.dur then
   moving=nil
   if solved() then state="win" win_timer=96 sfx(4)
   else state="game" end
  end
 elseif state=="win" then
  win_timer-=1
  if win_timer<=0 then
   if level_num<48 then begin_level(level_num+1)
   else state="ending" ending_timer=240 sfx(4) end
  end
 elseif state=="ending" then
  ending_timer-=1
  if ending_timer<=0 or btnp(5) then state="menu" end
 elseif state=="quit" then
  if btnp(4) then
   state=quit_return
   sfx(2)
  elseif btnp(2) then
   quit_yes=false
   sfx(0)
  elseif btnp(3) then
   quit_yes=true
   sfx(0)
  elseif btnp(5) then
   if quit_yes then state="menu" else state=quit_return end
   sfx(1)
  end
 elseif state=="tutorial" then
  update_tutorial()
 end
end

function draw_fences(mask)
 for r=0,2 do
  for c=0,1 do
   if band(mask,2^(r*2+c))!=0 then
    local bx=44+c*40
    local sy=4+r*40
    rectfill(bx-3,sy+2,bx+2,sy+37,1)
   end
  end
 end
 for r=0,1 do
  for c=0,2 do
   if band(mask,2^(6+r*3+c))!=0 then
    local by=44+r*40
    local sx=4+c*40
    rectfill(sx+2,by-3,sx+37,by+2,1)
   end
  end
 end
end

function draw_arena(mask)
 rectfill(0,0,127,127,4)
 rectfill(4,4,123,123,0)
 rectfill(0,0,43,3,3)
 rectfill(0,4,3,43,3)
 rectfill(44,0,83,3,6)
 rectfill(84,0,127,3,2)
 rectfill(124,4,127,43,2)
 rectfill(0,84,3,127,5)
 rectfill(4,124,43,127,5)
 rectfill(44,124,83,127,9)
 rectfill(84,124,127,127,7)
 rectfill(124,84,127,123,7)
 draw_fences(mask)
end

function draw_rainbow_border()
 local shift=flr(tick/5)
 for i=0,63 do
  local side=flr(i/16)
  local step=i%16
  local color=rainbow[(i+shift)%6+1]
  if side==0 then
   rectfill(step*8,0,min(123,step*8+7),3,color)
  elseif side==1 then
   rectfill(124,step*8,127,min(123,step*8+7),color)
  elseif side==2 then
   local x=120-step*8
   rectfill(max(4,x),124,x+7,127,color)
  else
   local y=120-step*8
   rectfill(0,max(4,y),3,y+7,color)
  end
 end
end

function draw_animal(kind,x,y,bob)
 local px=8+x*40
 local py=8+y*40-(bob or 0)
 spr(sprite_id[kind],px,py,4,4)
end

function draw_cursor(x,y,color)
 local x0=8+x*40
 local y0=8+y*40
 local x1=x0+31
 local y1=y0+31
 for side=0,1 do
  local xx=side==0 and x0 or x1
  local hx=side==0 and 1 or -1
  for vertical=0,1 do
   local yy=vertical==0 and y0 or y1
   local hy=vertical==0 and 1 or -1
   rectfill(min(xx,xx+hx*4),min(yy,yy+hy),max(xx,xx+hx*4),max(yy,yy+hy),color)
   rectfill(min(xx,xx+hx),min(yy,yy+hy*4),max(xx,xx+hx),max(yy,yy+hy*4),color)
  end
 end
end

function draw_cross(x,y)
 local px=24+x*40
 local py=24+y*40
 for offset=-2,2 do
  line(px-6,py-6+offset,px+6,py+6+offset,15)
  line(px-6,py+6+offset,px+6,py-6+offset,15)
 end
end

function draw_heart(x,y)
 rectfill(x,y,x+1,y+1,5)
 rectfill(x+4,y,x+5,y+1,5)
 rectfill(x,y+2,x+5,y+3,5)
 rectfill(x+1,y+4,x+4,y+4,5)
 rectfill(x+2,y+5,x+3,y+5,5)
end

function draw_game()
 draw_arena(walls)
 if state=="win" then draw_rainbow_border() end
 for i=1,#animals do
  local a=animals[i]
  local x=a.x
  local y=a.y
  local bob=0
  if moving and moving.index==i then
   local t=moving.t/moving.dur
   x=moving.fx+(moving.tx-moving.fx)*t
   y=moving.fy+(moving.ty-moving.fy)*t
   if a.kind=="h" and abs(moving.tx-moving.fx)+abs(moving.ty-moving.fy)==2 then
    bob=16*(1-abs(2*t-1))
   end
  elseif state=="win" then
   bob=flr((win_timer+i*5)%18/9)*2
  end
  draw_animal(a.kind,x,y,bob)
 end
 local cursor_x=cx
 local cursor_y=cy
 if moving then
  local t=moving.t/moving.dur
  cursor_x=moving.fx+(moving.tx-moving.fx)*t
  cursor_y=moving.fy+(moving.ty-moving.fy)*t
 end
 if state!="win" then draw_cursor(cursor_x,cursor_y,selected and 7 or 1) end
 if bad_timer>0 and flr(bad_timer/4)%2==0 then draw_cross(cx,cy) end
 if state=="win" then
  for i=0,2 do draw_heart(43+i*17,58+(win_timer+i*4)%8) end
 end
end

function draw_menu()
 draw_arena(323)
 draw_animal("b",0,0)
 draw_animal("h",2,0)
 center("turtles",16,1)
 center("& hare",25,1)
 for i=1,4 do
  local x=(i-1)%3
  local y=1+flr((i-1)/3)
  local label=names[i]
  print(label,24+x*40-#label*2,61+(y-1)*40,difficulty_colors[i])
 end
 print("tutorial",48,101,1)
 print("x start",90,94,1)
 print("z demo",92,104,1)
 draw_cursor(menu_x,menu_y,1)
end

function draw_intro()
 draw_arena(0)
 rectfill(14,30,113,96,1)
 rect(14,30,113,96,7)
 big_text(names[flr((level_num-1)/12)+1],40,7)
 big_text(level_num.."/48",69,7)
end

function draw_quit()
 draw_game()
 rectfill(14,35,113,94,1)
 rect(14,35,113,94,7)
 center("quit?",42,7)
 center("are you sure?",52,7)
 center("no",69,7)
 center("yes",82,7)
 local y=quit_yes and 79 or 66
 rect(49,y,78,y+11,7)
end

function draw_goal_pulse(kind)
 local pos=goal_pos[kind]
 local x=4+(pos%3)*40
 local y=4+flr(pos/3)*40
 local color=goal_col[kind]
 rect(x+1,y+1,x+38,y+38,color)
 rect(x+2,y+2,x+37,y+37,color)
end

function draw_tutorial()
 local t=flr(tutorial_frame*2/5)
 -- fence between top and middle in center column
 draw_arena(128)
 local tx=0
 local ty=2
 if t>=30 then ty=max(1,2-min(1,(t-30)/12)) end
 if t>=60 then tx=min(1,(t-60)/12) end
 if t>=181 then ty=min(2,1+(t-181)/12) end
 draw_animal("b",tx,ty)
 local hx=0
 local hy=1
 local hare_visible=t>=121
 if hare_visible then
  local bob=0
  if t>=151 then
   local p=min(1,(t-151)/12)
   hx=2*p
   bob=16*(1-abs(2*p-1))
  end
  if t>=241 then hy=max(0,1-min(1,(t-241)/12)) end
  if t>=271 then hx=max(1,2-min(1,(t-271)/12)) end
  draw_animal("h",hx,hy,bob)
 end
 if t<121 then
  draw_cursor(tx,ty,7)
 elseif t<181 then
  draw_cursor(hx,hy,7)
 elseif t<241 then
  draw_cursor(tx,ty,7)
 elseif t<301 then
  draw_cursor(hx,hy,7)
 end
 if t>=90 and t<112 then
  rectfill(62,47,66,64,15)
  draw_cross(1,0)
 end
 if t>=211 and t<241 and flr(t/5)%2==0 then draw_goal_pulse("b") end
 if t>=301 and flr(t/5)%2==0 then draw_goal_pulse("h") end
 if t>=320 then
  for i=0,2 do draw_heart(43+i*17,58+(t+i*4)%8) end
 end
end

function draw_ending()
 draw_arena(0)
 draw_rainbow_border()
 draw_animal("g",0,0)
 draw_animal("h",1,0)
 draw_animal("p",2,0)
 draw_animal("r",0,2)
 draw_animal("b",1,2)
 draw_animal("y",2,2)
 rectfill(24,51,103,75,1)
 center("game over",55,7)
 for i=0,2 do draw_heart(43+i*17,67+(tick+i*4)%8) end
end

function _draw()
 if state=="menu" then draw_menu()
 elseif state=="intro" then draw_intro()
 elseif state=="game" or state=="moving" or state=="win" then draw_game()
 elseif state=="tutorial" then draw_tutorial()
 elseif state=="ending" then draw_ending()
 elseif state=="quit" then draw_quit() end
end

